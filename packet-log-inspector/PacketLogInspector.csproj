<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PacketLogInspector</RootNamespace>
    <AssemblyName>PacketLogInspector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.Secrets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EggEgg.CSharp-Logger" Version="4.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OldProtoHandlers\OldProtoHandlers.csproj" />
    <ProjectReference Include="..\NewProtoHandlers\NewProtoHandlers.csproj" />
  </ItemGroup>

  <!-- Build Vue frontend before building the C# project -->
  <Target Name="BuildVueFrontend" BeforeTargets="Build"
          Condition="'$(SkipVueBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)\frontend\package.json')">
    <Message Text="Building Vue frontend..." Importance="high" />
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)\frontend"
          ConsoleToMSBuild="true" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\frontend"
          ConsoleToMSBuild="true" />
  </Target>

</Project>
